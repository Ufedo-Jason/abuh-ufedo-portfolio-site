---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { education, learning, highlights } from '../data/credentials';
---
<BaseLayout title="Credentials" description="Education, selected technical learning, training and highlights from Abuh Ufedo's journey.">
  <div class="shell page-topline"><span>Background / 004</span><span>Education, learning & milestones</span></div>
  <section class="shell page-intro">
    <p class="eyebrow">The foundations</p>
    <h1>What I've studied.<br /><em>What I'm still learning.</em></h1>
    <p class="lead">A record of formal education, selected technical learning, training and milestones. I keep qualifications separate from short courses and independent study so the context stays clear.</p>
  </section>
  <section class="section">
    <div class="shell credentials-grid">
      <div class="credentials-label">01 / Formal education</div>
      <div class="credential-list">
        {education.map((item) => <article class="credential-item"><div><h3>{item.qualification}</h3><p>{item.institution}<br />{item.detail}</p></div><span class="credential-kind">Degree</span></article>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell credentials-grid">
      <div>
        <div class="credentials-label">02 / Technical learning</div>
        <p class="prose-small">A selection of courses and training related to digital design, VLSI, verification and RF circuit design.</p>
      </div>
      <div class="credential-list">
        {learning.map((item) => <article class="credential-item"><div><h3>{item.name}</h3><p>{item.provider}<br />{item.note}</p></div><span class="credential-kind">{item.kind}</span></article>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <SectionHeading eyebrow="03 / Selected milestones" title="A few markers along the way." />
      <div class="highlight-list">
        {highlights.map((item) => <article class="highlight-card"><time>{item.date}</time><h3>{item.title}</h3><p>{item.detail}</p></article>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell credentials-grid">
      <div>
        <div class="credentials-label">04 / Certificates & supporting documents</div>
        <p class="prose-small">Add clear scans or images of certificates, awards, transcripts and selected supporting documents here. Link to verification pages where available.</p>
      </div>
      <div class="certificate-drop">
        <h3>Your certificates, in context.</h3>
        <p>Create folders inside <code>public/certificates/</code>, add the certificate images or PDFs, then add the title, issuing organisation, date and link in <code>src/data/credentials.ts</code>. Avoid uploading sensitive personal identifiers or documents that should not be public.</p>
      </div>
    </div>
  </section>
</BaseLayout>
