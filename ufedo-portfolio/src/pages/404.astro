---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <section class="shell page-intro" style="min-height: 55vh; display:flex; flex-direction:column; justify-content:center;">
    <p class="eyebrow">404 / Wrong turn</p>
    <h1>This page seems<br /><em>to have wandered off.</em></h1>
    <p class="lead">The page may have moved, or the link may be incomplete.</p>
    <a class="arrow-link" href="/">Back to the homepage <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
