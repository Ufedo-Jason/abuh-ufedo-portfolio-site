---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const formattedDate = data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={data.title} description={data.description} image={data.cover}>
  <div class="shell page-topline"><span>Writing / Fieldnotes</span><span>{data.category}</span></div>
  <section class="shell detail-hero">
    <p class="eyebrow">{data.category} · {formattedDate} {data.readTime ? `· ${data.readTime}` : ''}</p>
    <h1>{data.title}</h1>
    <p class="detail-summary">{data.description}</p>
    <img class="detail-cover" src={data.cover} alt="Editorial illustration for this article" />
  </section>
  <section class="shell article-layout">
    <article class="prose">
      {data.draft && <div class="draft-notice"><strong>Starter draft:</strong> This article was prepared from the project and experience details available for the site. Read it carefully, personalise the voice and verify every detail before switching its <code>draft</code> setting to <code>false</code>.</div>}
      <Content />
    </article>
    <aside class="article-aside">
      <div class="article-aside-box">
        <p class="eyebrow">Filed under</p>
        <p>{data.category}</p>
        <div class="tag-list">{data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        <div class="spacer-sm"></div>
        <a class="text-link" href="/writing/">All writing <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </section>
</BaseLayout>
