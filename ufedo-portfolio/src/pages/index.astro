---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 2);
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<BaseLayout title={site.name}>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker">A personal archive · Est. in curiosity</div>
        <h1 class="hero-title">Curious about how things work. <em>Committed to making them work better.</em></h1>
        <p class="hero-description">I'm Abuh Ufedo, an electrical and electronics engineering graduate, project builder and curious learner. This is where I document the problems that hold my attention, the things I build, and the ideas I don't want to lose.</p>
        <div class="button-row">
          <a class="button-primary" href="/projects/">Explore my work <span aria-hidden="true">↗</span></a>
          <a class="button-secondary" href="/writing/">Read the fieldnotes <span aria-hidden="true">↗</span></a>
          {site.cvUrl && <a class="text-link" href={site.cvUrl} target="_blank" rel="noreferrer">Download CV <span aria-hidden="true">↓</span></a>}
        </div>
        <div class="hero-footnote">
          <span>Nigeria</span>
          <span>Engineering · Research · Writing</span>
        </div>
      </div>
      <div class="hero-visual" aria-label="Abstract graphic representing curiosity, engineering and interconnected ideas">
        <span class="hero-visual-caption">A mind in progress / 001</span>
        <div class="hero-art-frame">
          <div class="hero-gridlines"></div>
          <div class="hero-orbit"></div>
          <div class="hero-core"><small>FIELD / NOTES</small>AU</div>
          <div class="hero-coordinate">09°N 08°E<br />IDEAS IN MOTION<br />EST. ALWAYS</div>
          <div class="hero-stamp"><span>Build with purpose.<br />Learn without limits.</span></div>
          <div class="hero-label">Engineering a little beyond the obvious</div>
        </div>
      </div>
    </div>
  </section>

  <div class="interest-strip">
    <div class="shell interest-strip-inner">
      <span class="interest-strip-label">Areas of curiosity</span>
      {site.currentFocus.map((item) => <span class="interest-item">{item}</span>)}
    </div>
  </div>

  <section class="shell intro-band">
    <div class="intro-aside">A note on what<br />this space is for</div>
    <p class="intro-statement">A CV lists the milestones. This space keeps the <em>thinking, experiments, detours and small discoveries</em> that happen between them.</p>
    <p class="intro-side-note">A growing record of work and wonder: part portfolio, part notebook, part open-ended conversation.</p>
  </section>

  <section class="section" id="projects">
    <div class="shell">
      <SectionHeading eyebrow="Selected work / 01" title="Things I've helped bring to life." text="A selection of projects across hardware, healthcare technology and computational experiments. The important part is not just what was built, but the problem, decisions and learning behind it." number="01 — 04" />
      <div class="project-grid">
        {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="spacer-sm"></div>
      <a class="arrow-link" href="/projects/">View all projects <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="shell">
      <SectionHeading eyebrow="The notebook / 02" title="Things worth writing down." text="Technical notes, reflections from building, ideas I'm still working through and the occasional thought from outside engineering." number="02 — 04" />
      <div class="post-grid">
        {posts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
      </div>
      <div class="spacer-sm"></div>
      <a class="arrow-link" href="/writing/">Browse the writing archive <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section">
    <div class="shell two-panel">
      <article class="feature-panel feature-panel-dark">
        <span class="panel-number">03 / THE PERSON</span>
        <div class="panel-orbit"></div>
        <div>
          <h3>More than a list of qualifications.</h3>
          <p>The experiences, people, questions and motivations behind the work. A little more context on the person behind the projects.</p>
          <a class="text-link" href="/about/">Get to know me <span aria-hidden="true">↗</span></a>
        </div>
      </article>
      <article class="feature-panel feature-panel-light">
        <span class="panel-number">04 / THE PRESENT</span>
        <div class="panel-lines"></div>
        <div>
          <h3>What I'm exploring right now.</h3>
          <p>A living snapshot of current interests, experiments, reading and questions that have not quite let go.</p>
          <a class="text-link" href="/now/">See what I'm up to <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="contact-panel">
        <div>
          <p class="eyebrow">A good conversation can start anywhere</p>
          <h2>Have a question, an idea, or a problem worth thinking about?</h2>
          <p>I'm glad to connect with researchers, engineers, builders and people working on thoughtful ideas. The best collaborations often begin with a simple conversation.</p>
        </div>
        <div class="contact-options">
          <a class="contact-option" href="/contact/"><span>Get in touch</span><span>↗</span></a>
          <a class="contact-option" href="/projects/"><span>Explore selected work</span><span>↗</span></a>
          <a class="contact-option" href="/writing/"><span>Read something</span><span>↗</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
