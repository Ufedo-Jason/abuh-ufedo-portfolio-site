---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      readTime?: string;
      cover: string;
      draft?: boolean;
      tags: string[];
    };
  };
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { data } = post;
const date = data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class:list={["post-card", featured && "post-card-featured"]}>
  <a class="post-cover" href={`/writing/${post.id}/`} aria-label={`Read ${data.title}`}>
    <img src={data.cover} alt="" loading="lazy" />
    <span class="cover-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="post-details">
    <div class="post-meta">
      <span class="post-category">{data.category}</span>
      <span>{date}</span>
      {data.draft && <span class="draft-pill">Starter draft</span>}
    </div>
    <h3><a href={`/writing/${post.id}/`}>{data.title}</a></h3>
    <p>{data.description}</p>
    <a class="text-link" href={`/writing/${post.id}/`}>Read the note <span aria-hidden="true">↗</span></a>
  </div>
</article>
