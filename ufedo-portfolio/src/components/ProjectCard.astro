---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary: string;
      category: string;
      period: string;
      status: string;
      cover: string;
      tags: string[];
      featured?: boolean;
    };
  };
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { data } = project;
---
<article class="project-card">
  <a class="project-art" href={`/projects/${project.id}/`} aria-label={`Read the ${data.title} case study`}>
    <img src={data.cover} alt="" loading="lazy" />
    <span class="art-index">0{index + 1}</span>
    <span class="art-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-card-meta">
    <span>{data.category}</span>
    <span>{data.period}</span>
  </div>
  <h3><a href={`/projects/${project.id}/`}>{data.title}</a></h3>
  <p>{data.summary}</p>
  <div class="tag-list">
    {data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <div class="project-card-foot">
    <span class="status-dot"><i></i>{data.status}</span>
    <a class="text-link" href={`/projects/${project.id}/`}>Explore project <span aria-hidden="true">↗</span></a>
  </div>
</article>
